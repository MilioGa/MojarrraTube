<Window x:Class="MojarraTube.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MojarraTube"
        Title="MojarraTube" Width="1360" Height="860" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Fondo}" Foreground="{DynamicResource Texto}"
        FontFamily="{StaticResource Letra}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        AllowDrop="True" Icon="pack://application:,,,/icon.png">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Raiz">
    <Grid x:Name="Principal">
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ═════ Barra superior ═════ -->
      <Grid x:Name="BarraSuperior" Background="{DynamicResource Fondo}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
          <Button x:Name="BtnMenu" Style="{StaticResource BtnIcono}" Content="&#xE700;" WindowChrome.IsHitTestVisibleInChrome="True" Click="Menu_Click" ToolTip="Menú" AutomationProperties.Name="Menú"/>
          <Button x:Name="BtnAtras" Style="{StaticResource BtnIcono}" Content="&#xE72B;" WindowChrome.IsHitTestVisibleInChrome="True" Click="Atras_Click" ToolTip="Atrás (Alt+←)" IsEnabled="False" AutomationProperties.Name="Atrás"/>
          <Button x:Name="Logo" WindowChrome.IsHitTestVisibleInChrome="True" Click="Logo_Click" Cursor="Hand" Margin="6,0,0,0" ToolTip="Inicio" FocusVisualStyle="{x:Null}">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <StackPanel Orientation="Horizontal" Background="Transparent">
                  <Image Source="pack://application:,,,/icon.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <TextBlock x:Name="LogoTexto" Text="MojarraTube" FontFamily="{StaticResource LetraTitulo}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,1"/>
                </StackPanel>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>

        <!-- Buscador -->
        <Grid Grid.Column="1" MaxWidth="660" Margin="20,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <Border x:Name="CajaBusqueda" Height="40" CornerRadius="20" Background="{DynamicResource Superficie2}" BorderBrush="{DynamicResource Linea}" BorderThickness="1.5">
            <Grid Margin="14,0,4,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="IconoBusqueda" Text="&#xE721;" Style="{StaticResource Icono}" FontSize="15" Foreground="{DynamicResource Tenue}"/>
              <TextBox x:Name="Busqueda" Grid.Column="1" Style="{StaticResource CajaLimpia}" Margin="10,0,6,0" Tag="Buscar en YouTube o pegar un enlace de cualquier página"
                       KeyDown="Busqueda_KeyDown" PreviewKeyDown="Busqueda_PreviewKeyDown" TextChanged="Busqueda_TextChanged" GotKeyboardFocus="Busqueda_Foco" LostKeyboardFocus="Busqueda_SinFoco"
                       AutomationProperties.Name="Buscar"/>
              <Button x:Name="BtnLimpiar" Grid.Column="2" Style="{StaticResource BtnIcono}" Width="30" Height="30" FontSize="11" Content="&#xE711;" Click="Limpiar_Click" Visibility="Collapsed" ToolTip="Borrar" AutomationProperties.Name="Borrar búsqueda"/>
              <Border x:Name="PistaAtajo" Grid.Column="3" CornerRadius="5" BorderBrush="{DynamicResource LineaFuerte}" BorderThickness="1" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="Ctrl K" FontSize="11" Foreground="{DynamicResource MuyTenue}"/>
              </Border>
            </Grid>
          </Border>
          <Popup x:Name="PopupSugerencias" PlacementTarget="{Binding ElementName=CajaBusqueda}" Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border Background="{DynamicResource Superficie2}" BorderBrush="{DynamicResource Linea}" BorderThickness="1" CornerRadius="14" Padding="6" Margin="0,0,10,10"
                    Width="{Binding ActualWidth, ElementName=CajaBusqueda}">
              <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="{DynamicResource cSombra}"/></Border.Effect>
              <ListBox x:Name="ListaSugerencias" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Texto}" FontSize="14"
                       PreviewMouseLeftButtonUp="Sugerencia_Clic" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="b" CornerRadius="8" Padding="10,8" Background="Transparent">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Superficie3}"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Icono}" FontFamily="{StaticResource Iconos}" FontSize="14" Foreground="{DynamicResource Tenue}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Texto}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Popup>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
          <Button x:Name="BtnBuscarMovil" Style="{StaticResource BtnIcono}" Content="&#xE721;" WindowChrome.IsHitTestVisibleInChrome="True" Click="BuscarMovil_Click" Visibility="Collapsed" ToolTip="Buscar (Ctrl+K)" AutomationProperties.Name="Buscar"/>
          <Button Style="{StaticResource BtnIcono}" Content="&#xE8E5;" WindowChrome.IsHitTestVisibleInChrome="True" Click="AbrirArchivo_Click" ToolTip="Abrir un archivo del equipo (Ctrl+O)" AutomationProperties.Name="Abrir archivo"/>
          <Button x:Name="BtnDescargas" Style="{StaticResource BtnIcono}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Descargas_Click" ToolTip="Descargas (Ctrl+J)" AutomationProperties.Name="Descargas">
            <Grid>
              <TextBlock Text="&#xE896;" FontFamily="{StaticResource Iconos}" FontSize="15"/>
              <Border x:Name="Insignia" Background="{DynamicResource Acento}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0" Margin="0,-12,-16,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                <TextBlock x:Name="InsigniaTexto" FontFamily="{StaticResource Letra}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Style="{StaticResource BtnVentana}" Content="&#xE921;" Click="Minimizar_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimizar"/>
          <Button x:Name="BtnMaximizar" Style="{StaticResource BtnVentana}" Content="&#xE922;" Click="Maximizar_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximizar"/>
          <Button Style="{StaticResource BtnCerrarVentana}" Content="&#xE8BB;" Click="Cerrar_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Cerrar"/>
        </StackPanel>
      </Grid>

      <!-- ═════ Estado de componentes (primera vez / actualización) ═════ -->
      <Border x:Name="BarraComponentes" Grid.Row="1" Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Linea}" BorderThickness="0,1" Padding="18,10" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="ComponentesIcono" Text="&#xE896;" Style="{StaticResource Icono}" Foreground="{DynamicResource Acento}" Margin="0,0,12,0"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="ComponentesTexto" FontSize="13" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="ComponentesBarra" Style="{StaticResource BarraFina}" Margin="0,6,0,0" Maximum="1" MaxWidth="520" HorizontalAlignment="Left" Width="520"/>
          </StackPanel>
          <Button x:Name="BtnReintentarComponentes" Grid.Column="2" Style="{StaticResource Btn}" Content="Reintentar" Click="ReintentarComponentes_Click" Visibility="Collapsed"/>
        </Grid>
      </Border>

      <!-- ═════ Menú lateral + contenido ═════ -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="ColMenu" Width="236"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="MenuLateral" Background="{DynamicResource Fondo}">
          <ScrollViewer x:Name="MenuScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MenuItems" Margin="10,6,10,16">
              <RadioButton x:Name="NavInicio" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Inicio" Click="NavInicio_Click" ToolTip="Inicio"/>
              <RadioButton x:Name="NavSuscripciones" Style="{StaticResource NavItem}" Tag="&#xE8F2;" Content="Suscripciones" Click="NavSuscripciones_Click" ToolTip="Suscripciones"/>
              <RadioButton x:Name="NavBiblioteca" Style="{StaticResource NavItem}" Tag="&#xE8F1;" Content="Biblioteca" Click="NavBiblioteca_Click" ToolTip="Biblioteca: tus archivos, historial y Ver más tarde (Ctrl+H)"/>
              <RadioButton x:Name="NavDescargas" Style="{StaticResource NavItem}" Tag="&#xE896;" Content="Descargas" Click="NavDescargas_Click" ToolTip="Descargas (Ctrl+J)"/>
              <Border x:Name="SepCanales" Height="1" Background="{DynamicResource Linea}" Margin="8,12"/>
              <TextBlock x:Name="TituloCanales" Text="Canales" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Tenue}" Margin="14,0,0,6"/>
              <ItemsControl x:Name="ListaCanales" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:Canal}">
                    <Button Click="CanalMenu_Click" Cursor="Hand" ToolTip="{Binding Nombre}" FocusVisualStyle="{x:Null}" Height="38">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="b" CornerRadius="10" Background="Transparent" Padding="12,0" BorderThickness="1.5" BorderBrush="Transparent">
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                              <Grid Width="24" Height="24">
                                <Ellipse Fill="{DynamicResource Superficie3}"/>
                                <TextBlock Text="{Binding Inicial}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Tenue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image local:Img.Fuente="{Binding Avatar}" local:Img.Ancho="64">
                                  <Image.Clip><EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12"/></Image.Clip>
                                </Image>
                              </Grid>
                              <TextBlock x:Name="t" Grid.Column="1" Text="{Binding Nombre}" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Texto}"/>
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Acento}"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Height="1" Background="{DynamicResource Linea}" Margin="8,12"/>
              <RadioButton x:Name="NavAjustes" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Ajustes" Click="NavAjustes_Click" ToolTip="Ajustes (Ctrl+,)"/>
              <RadioButton x:Name="NavAyuda" Style="{StaticResource NavItem}" Tag="&#xE765;" Content="Atajos de teclado" Click="NavAyuda_Click" ToolTip="Atajos de teclado (F1)" GroupName="ayuda"/>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Grid x:Name="Contenido" Grid.Column="1" ClipToBounds="True"/>
      </Grid>
    </Grid>

    <!-- ═════ Menú lateral flotante (pantallas angostas) ═════ -->
    <Grid x:Name="CapaMenu" Visibility="Collapsed">
      <Border x:Name="VeloMenu" Background="{DynamicResource Velo}" MouseLeftButtonDown="VeloMenu_Click"/>
      <Border x:Name="MenuFlotante" Width="260" HorizontalAlignment="Left" Background="{DynamicResource Fondo}" BorderBrush="{DynamicResource Linea}" BorderThickness="0,0,1,0">
        <Border.RenderTransform><TranslateTransform x:Name="MenuFlotanteMov"/></Border.RenderTransform>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
            <Button Style="{StaticResource BtnIcono}" Content="&#xE700;" Click="VeloMenu_Click" AutomationProperties.Name="Cerrar menú"/>
            <Image Source="pack://application:,,,/icon.png" Width="28" Height="28" Margin="6,0,0,0"/>
            <TextBlock Text="MojarraTube" FontFamily="{StaticResource LetraTitulo}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,1"/>
          </StackPanel>
          <ContentControl x:Name="HuecoMenuFlotante" Grid.Row="1" Focusable="False"/>
        </Grid>
      </Border>
    </Grid>

    <!-- ═════ Minirreproductor ═════ -->
    <Border x:Name="Mini" Width="400" Height="225" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"
            CornerRadius="14" Background="Black" Visibility="Collapsed">
      <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="Black"/></Border.Effect>
      <Grid x:Name="HuecoMini" local:Forma.Radio="14"/>
    </Border>

    <!-- ═════ Avisos ═════ -->
    <StackPanel x:Name="Avisos" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,20,24" IsHitTestVisible="True"/>

    <!-- ═════ Diálogos ═════ -->
    <Grid x:Name="CapaDialogo" Visibility="Collapsed">
      <Border Background="{DynamicResource Velo}" MouseLeftButtonDown="VeloDialogo_Click"/>
      <Border x:Name="CajaDialogo" Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Linea}" BorderThickness="1" CornerRadius="18"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" MaxWidth="640" RenderTransformOrigin="0.5,0.5">
        <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.45" Color="{DynamicResource cSombra}"/></Border.Effect>
        <Border.RenderTransform><ScaleTransform x:Name="DialogoEscala"/></Border.RenderTransform>
        <ContentControl x:Name="HuecoDialogo" Focusable="False"/>
      </Border>
    </Grid>

    <!-- ═════ Pantalla completa ═════ -->
    <Grid x:Name="CapaCompleta" Background="Black" Visibility="Collapsed"/>
  </Grid>
</Window>
