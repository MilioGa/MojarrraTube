<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MojarraTube">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Estilos.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <local:BoolAVisible x:Key="AVisible"/>
  <local:BoolAVisible x:Key="AOculto" Invertir="True"/>
  <local:FraccionAEscala x:Key="AEscala"/>

  <!-- Botón que envuelve una tarjeta (clic, foco con teclado, menú) -->
  <Style x:Key="BtnTarjeta" TargetType="{x:Type Button}">
    <Setter Property="local:Acciones.Tarjeta" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="b" Background="Transparent" BorderThickness="2" BorderBrush="Transparent" CornerRadius="14" Margin="-6" Padding="4">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Acento}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Miniatura 16:9 con duración y progreso visto -->
  <DataTemplate x:Key="Miniatura" DataType="{x:Type local:Video}">
    <Grid local:Forma.Proporcion="1.7778" local:Forma.Radio="12" Background="{DynamicResource Esqueleto}">
      <Image x:Name="img" local:Img.Fuente="{Binding Miniatura}" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.RenderTransform><ScaleTransform x:Name="zoom"/></Image.RenderTransform>
      </Image>
      <TextBlock Text="&#xE714;" FontFamily="{StaticResource Iconos}" FontSize="28" Foreground="{DynamicResource MuyTenue}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Source, ElementName=img, Converter={StaticResource AOculto}}"/>
      <!-- Lista -->
      <Border Background="#CC000000" HorizontalAlignment="Right" Width="96" Visibility="{Binding EsLista, Converter={StaticResource AVisible}}">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="&#xE90B;" FontFamily="{StaticResource Iconos}" FontSize="22" Foreground="White" HorizontalAlignment="Center"/>
          <TextBlock Text="Lista" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <!-- Solo audio -->
      <Border Background="#CC000000" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Visibility="{Binding SoloAudio, Converter={StaticResource AVisible}}">
        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Iconos}" FontSize="12" Foreground="White"/>
      </Border>
      <Border x:Name="dur" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Background="#D9000000"
              Visibility="{Binding HayDuracion, Converter={StaticResource AVisible}}">
        <TextBlock Text="{Binding DuracionTexto}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
      </Border>
      <Grid VerticalAlignment="Bottom" Height="4" Background="#66FFFFFF" Visibility="{Binding HayProgreso, Converter={StaticResource AVisible}}">
        <Border Background="{DynamicResource Acento}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
          <Border.RenderTransform><ScaleTransform ScaleX="{Binding Progreso, Converter={StaticResource AEscala}}"/></Border.RenderTransform>
        </Border>
      </Grid>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding EnVivo}" Value="True"><Setter TargetName="dur" Property="Background" Value="#E6E5213B"/></DataTrigger>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
        <DataTrigger.EnterActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
        </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
        <DataTrigger.ExitActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25"/>
          <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25"/>
        </Storyboard></BeginStoryboard></DataTrigger.ExitActions>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Avatar redondo con la inicial del canal -->
  <DataTemplate x:Key="Avatar">
    <Grid Width="36" Height="36">
      <Ellipse Fill="{DynamicResource Superficie3}"/>
      <TextBlock Text="{Binding Inicial}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Tenue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
  </DataTemplate>

  <!-- Tarjeta de video para rejillas -->
  <DataTemplate x:Key="TarjetaVideo" DataType="{x:Type local:Video}">
    <Button Style="{StaticResource BtnTarjeta}" AutomationProperties.Name="{Binding Titulo}">
      <StackPanel>
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Miniatura}"/>
        <Grid Margin="2,12,2,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar}" VerticalAlignment="Top" Margin="0,0,12,0" Visibility="{Binding EsLocal, Converter={StaticResource AOculto}}"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" LineHeight="21" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource Texto}"/>
            <TextBlock Text="{Binding Canal}" FontSize="13" Foreground="{DynamicResource Tenue}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Meta}" FontSize="13" Foreground="{DynamicResource Tenue}" TextTrimming="CharacterEllipsis" Visibility="{Binding Meta, Converter={StaticResource AVisible}}"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Button>
  </DataTemplate>

  <!-- Tarjeta de canal -->
  <DataTemplate x:Key="TarjetaCanal" DataType="{x:Type local:Video}">
    <Button Style="{StaticResource BtnTarjeta}" AutomationProperties.Name="{Binding Canal}">
      <StackPanel>
        <Grid local:Forma.Proporcion="1.7778">
          <Grid Width="116" Height="116" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Fill="{DynamicResource Superficie3}"/>
            <TextBlock Text="{Binding Inicial}" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource Tenue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image local:Img.Fuente="{Binding Miniatura}" local:Img.Ancho="240" Stretch="UniformToFill">
              <Image.Clip><EllipseGeometry Center="58,58" RadiusX="58" RadiusY="58"/></Image.Clip>
            </Image>
          </Grid>
        </Grid>
        <TextBlock Text="{Binding Canal}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="Canal" FontSize="13" Foreground="{DynamicResource Tenue}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Button>
  </DataTemplate>

  <local:SelectorTarjeta x:Key="SelectorTarjeta" Video="{StaticResource TarjetaVideo}" Canal="{StaticResource TarjetaCanal}"/>

  <!-- Fila compacta (columna lateral, cola, historial) -->
  <DataTemplate x:Key="FilaVideo" DataType="{x:Type local:Video}">
    <Button Style="{StaticResource BtnTarjeta}" Margin="0,0,0,12" AutomationProperties.Name="{Binding Titulo}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Miniatura}" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1" Margin="10,0,0,0">
          <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
          <TextBlock Text="{Binding Canal}" FontSize="12" Foreground="{DynamicResource Tenue}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource Tenue}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>
    </Button>
  </DataTemplate>

  <!-- Esqueleto mientras carga -->
  <DataTemplate x:Key="Esqueleto">
    <StackPanel>
      <Border local:Forma.Proporcion="1.7778" CornerRadius="12" Background="{DynamicResource Esqueleto}"/>
      <Grid Margin="2,12,2,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Ellipse Width="36" Height="36" Fill="{DynamicResource Esqueleto}" VerticalAlignment="Top" Margin="0,0,12,0"/>
        <StackPanel Grid.Column="1">
          <Border Height="14" CornerRadius="4" Background="{DynamicResource Esqueleto}" Margin="0,2,20,0"/>
          <Border Height="14" CornerRadius="4" Background="{DynamicResource Esqueleto}" Margin="0,8,60,0"/>
          <Border Height="12" CornerRadius="4" Background="{DynamicResource Esqueleto}" Margin="0,10,100,0"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </DataTemplate>


  <!-- Fila de una descarga -->
  <Style x:Key="BtnDescarga" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnIcono}">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Margin" Value="2,0"/>
  </Style>
  <DataTemplate x:Key="FilaDescarga" DataType="{x:Type local:Descarga}">
    <Border Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Linea}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Width="136" local:Forma.Proporcion="1.7778" local:Forma.Radio="9" Background="{DynamicResource Esqueleto}" VerticalAlignment="Top">
          <Image local:Img.Fuente="{Binding Miniatura}" local:Img.Ancho="320" Stretch="UniformToFill"/>
          <Border CornerRadius="5" Background="#CC000000" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6">
            <TextBlock Text="{Binding Icono}" FontFamily="{StaticResource Iconos}" FontSize="11" Foreground="White"/>
          </Border>
        </Grid>
        <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Titulo}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Titulo}"/>
          <TextBlock FontSize="12.5" Foreground="{DynamicResource Tenue}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding Formato, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Canal, Mode=OneWay}"/>
          </TextBlock>
          <ProgressBar x:Name="barra" Style="{StaticResource BarraFina}" Maximum="1" Value="{Binding Fraccion, Mode=OneWay}" IsIndeterminate="{Binding Indeterminado, Mode=OneWay}" Margin="0,10,0,6" Visibility="{Binding Activa, Converter={StaticResource AVisible}}"/>
          <TextBlock x:Name="estado" FontSize="12.5" Foreground="{DynamicResource Tenue}" TextWrapping="Wrap" Margin="0,2,0,0">
            <Run x:Name="estadoTexto" Text="{Binding EstadoTexto, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Detalle, Mode=OneWay}"/>
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource BtnDescarga}" Content="&#xE768;" ToolTip="Reproducir" local:AccionDescarga.Accion="abrir" Visibility="{Binding Terminada, Converter={StaticResource AVisible}}" AutomationProperties.Name="Reproducir"/>
          <Button Style="{StaticResource BtnDescarga}" Content="&#xE838;" ToolTip="Mostrar en la carpeta" local:AccionDescarga.Accion="carpeta" Visibility="{Binding Terminada, Converter={StaticResource AVisible}}" AutomationProperties.Name="Mostrar en la carpeta"/>
          <Button Style="{StaticResource BtnDescarga}" Content="&#xE769;" ToolTip="Pausar" local:AccionDescarga.Accion="pausar" Visibility="{Binding PuedePausar, Converter={StaticResource AVisible}}" AutomationProperties.Name="Pausar"/>
          <Button Style="{StaticResource BtnDescarga}" Content="&#xE72C;" ToolTip="Reanudar / reintentar" local:AccionDescarga.Accion="reanudar" Visibility="{Binding PuedeReanudar, Converter={StaticResource AVisible}}" AutomationProperties.Name="Reanudar"/>
          <Button Style="{StaticResource BtnDescarga}" Content="&#xE711;" ToolTip="Cancelar descarga" local:AccionDescarga.Accion="cancelar" Visibility="{Binding Activa, Converter={StaticResource AVisible}}" AutomationProperties.Name="Cancelar"/>
          <Button Style="{StaticResource BtnDescarga}" Content="&#xE712;" ToolTip="Más opciones" local:AccionDescarga.Accion="menu" AutomationProperties.Name="Más opciones"/>
        </StackPanel>
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding ConError}" Value="True"><Setter TargetName="estadoTexto" Property="Foreground" Value="{DynamicResource Peligro}"/></DataTrigger>
      <DataTrigger Binding="{Binding Terminada}" Value="True"><Setter TargetName="estadoTexto" Property="Foreground" Value="{DynamicResource Ok}"/></DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Rejilla de tarjetas -->
  <ItemsPanelTemplate x:Key="PanelRejilla"><local:Rejilla/></ItemsPanelTemplate>
  <Style x:Key="ListaRejilla" TargetType="{x:Type ItemsControl}">
    <Setter Property="ItemsPanel" Value="{StaticResource PanelRejilla}"/>
    <Setter Property="ItemTemplateSelector" Value="{StaticResource SelectorTarjeta}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
  </Style>
  <Style x:Key="ListaEsqueleto" TargetType="{x:Type ItemsControl}">
    <Setter Property="ItemsPanel" Value="{StaticResource PanelRejilla}"/>
    <Setter Property="ItemTemplate" Value="{StaticResource Esqueleto}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Style.Triggers>
      <Trigger Property="Visibility" Value="Visible">
        <Trigger.EnterActions><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True">
          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.8"/>
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
