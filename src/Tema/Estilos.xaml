<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="Iconos">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Letra">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="LetraTitulo">Segoe UI Variable Display, Segoe UI</FontFamily>
  <CubicEase x:Key="Suave" EasingMode="EaseOut"/>

  <Style TargetType="{x:Type ToolTip}">
    <Setter Property="Background" Value="{DynamicResource Superficie3}"/>
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Linea}"/>
    <Setter Property="Padding" Value="9,5"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Texto -->
  <Style x:Key="Titulo" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource LetraTitulo}"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
  </Style>
  <Style x:Key="Subtitulo" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource LetraTitulo}"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
  </Style>
  <Style x:Key="TextoTenue" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource Tenue}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Icono" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource Iconos}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <!-- Botón de icono -->
  <Style x:Key="BtnIcono" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontFamily" Value="{StaticResource Iconos}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="18" BorderThickness="1.5" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Presionado}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Acento}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botón de icono sobre video (siempre claro) -->
  <Style x:Key="BtnVideo" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnIcono}">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="b" Background="Transparent" CornerRadius="20" BorderThickness="1.5" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#26FFFFFF"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#40FFFFFF"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#AAFFFFFF"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botones de la ventana -->
  <Style x:Key="BtnVentana" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    <Setter Property="FontFamily" Value="{StaticResource Iconos}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BtnCerrarVentana" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnVentana}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botón con texto -->
  <Style x:Key="Btn" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    <Setter Property="Background" Value="{DynamicResource Superficie3}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="18"/>
            <Border x:Name="h" Background="{DynamicResource Hover}" CornerRadius="18" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="h" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="h" Property="Background" Value="{DynamicResource Presionado}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Texto}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BtnPrimario" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{DynamicResource Acento}"/>
    <Setter Property="Foreground" Value="{DynamicResource AcentoTexto}"/>
  </Style>
  <Style x:Key="BtnFantasma" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineaFuerte}"/>
  </Style>
  <Style x:Key="BtnEnlace" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource Tenue}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <ContentPresenter x:Name="c"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Texto}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource Acento}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chips (filtros y opciones) -->
  <Style x:Key="Chip" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    <Setter Property="Background" Value="{DynamicResource Superficie3}"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="Margin" Value="0,0,8,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid>
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" BorderThickness="1.5" BorderBrush="Transparent"/>
            <Border x:Name="h" Background="{DynamicResource Hover}" CornerRadius="9" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="h" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource Texto}"/>
              <Setter Property="Foreground" Value="{DynamicResource Fondo}"/>
              <Setter TargetName="h" Property="Opacity" Value="0"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Acento}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Elementos del menú lateral: Tag = icono -->
  <Style x:Key="NavItem" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    <Setter Property="Height" Value="42"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="GroupName" Value="nav"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid>
            <Border x:Name="b" Background="Transparent" CornerRadius="10" BorderThickness="1.5" BorderBrush="Transparent"/>
            <Border x:Name="barra" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource Acento}" HorizontalAlignment="Left" Margin="0" Opacity="0"/>
            <Grid Margin="14,0,10,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="ico" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Iconos}" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <ContentPresenter x:Name="txt" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource Superficie3}"/>
              <Setter TargetName="barra" Property="Opacity" Value="1"/>
              <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource Acento}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Acento}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- Menú lateral compacto: icono con etiqueta pequeña debajo -->
  <Style x:Key="NavItemCompacto" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource NavItem}">
    <Setter Property="Height" Value="62"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid>
            <Border x:Name="b" Background="Transparent" CornerRadius="10" BorderThickness="1.5" BorderBrush="Transparent"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="ico" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Iconos}" FontSize="19" HorizontalAlignment="Center"/>
              <ContentPresenter HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource Superficie3}"/>
              <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource Acento}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Acento}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- Opción en forma de fila (calidades, formatos) -->
  <Style x:Key="OpcionFila" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border x:Name="b" Background="Transparent" BorderBrush="{DynamicResource Linea}" BorderThickness="1.5" CornerRadius="10" Padding="12,9">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0">
                <Ellipse x:Name="aro" Stroke="{DynamicResource LineaFuerte}" StrokeThickness="2"/>
                <Ellipse x:Name="punto" Width="8" Height="8" Fill="{DynamicResource Acento}" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Acento}"/>
              <Setter TargetName="b" Property="Background" Value="{DynamicResource AcentoSuave}"/>
              <Setter TargetName="aro" Property="Stroke" Value="{DynamicResource Acento}"/>
              <Setter TargetName="punto" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Texto}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Caja de texto sin borde (va dentro de un Border propio) -->
  <Style x:Key="CajaLimpia" TargetType="{x:Type TextBox}">
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Texto}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Acento}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Grid>
            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource MuyTenue}" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Caja de texto con borde -->
  <Style x:Key="Caja" TargetType="{x:Type TextBox}" BasedOn="{StaticResource CajaLimpia}">
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border x:Name="b" Background="{DynamicResource Superficie2}" BorderBrush="{DynamicResource Linea}" BorderThickness="1.5" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <Grid>
              <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource MuyTenue}" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Acento}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Barras de desplazamiento finas -->
  <Style x:Key="PulgarScroll" TargetType="{x:Type Thumb}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border x:Name="t" Background="{DynamicResource LineaFuerte}" CornerRadius="4"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="{DynamicResource MuyTenue}"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="{DynamicResource Tenue}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BotonPaginaScroll" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="{x:Type RepeatButton}"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource BotonPaginaScroll}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource BotonPaginaScroll}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource PulgarScroll}"/></Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="4,2">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource BotonPaginaScroll}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource BotonPaginaScroll}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource PulgarScroll}"/></Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Menús contextuales -->
  <Style TargetType="{x:Type ContextMenu}">
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="HasDropShadow" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border Background="{DynamicResource Superficie2}" BorderBrush="{DynamicResource Linea}" BorderThickness="1" CornerRadius="10" Padding="5" Margin="0,0,8,8">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="{DynamicResource cSombra}"/></Border.Effect>
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" MinWidth="190"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type MenuItem}">
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,7">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Iconos}" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Tenue}"/>
              <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="18,0,0,0" Foreground="{DynamicResource MuyTenue}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type Separator}">
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="{x:Type Separator}"><Border Height="1" Background="{DynamicResource Linea}" Margin="6,4"/></ControlTemplate></Setter.Value>
    </Setter>
  </Style>

  <!-- Barra de progreso fina -->
  <Style x:Key="BarraFina" TargetType="{x:Type ProgressBar}">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Foreground" Value="{DynamicResource Acento}"/>
    <Setter Property="Background" Value="{DynamicResource Superficie3}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Grid x:Name="TemplateRoot">
            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
            <Border x:Name="PART_Track"/>
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
            <Border x:Name="Indeterminado" Background="{TemplateBinding Foreground}" CornerRadius="2" Width="60" HorizontalAlignment="Left" Visibility="Collapsed">
              <Border.RenderTransform><TranslateTransform x:Name="mov"/></Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Indeterminado" Property="Visibility" Value="Visible"/>
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="sbInd">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="mov" Storyboard.TargetProperty="X" From="-60" To="400" Duration="0:0:1.3"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions><StopStoryboard BeginStoryboardName="sbInd"/></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Interruptor (CheckBox) -->
  <Style x:Key="Interruptor" TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Border x:Name="pista" Grid.Column="1" Width="42" Height="22" CornerRadius="11" Background="{DynamicResource Superficie3}" BorderBrush="{DynamicResource LineaFuerte}" BorderThickness="1.5">
              <Ellipse x:Name="bola" Width="12" Height="12" Fill="{DynamicResource Tenue}" HorizontalAlignment="Left" Margin="4,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="tr"/></Ellipse.RenderTransform>
              </Ellipse>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="pista" Property="Background" Value="{DynamicResource Acento}"/>
              <Setter TargetName="pista" Property="BorderBrush" Value="{DynamicResource Acento}"/>
              <Setter TargetName="bola" Property="Fill" Value="White"/>
              <Setter TargetName="bola" Property="Width" Value="14"/>
              <Setter TargetName="bola" Property="Height" Value="14"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="tr" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="tr" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="pista" Property="BorderBrush" Value="{DynamicResource Texto}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Deslizador (volumen) -->
  <Style x:Key="BotonPistaSlider" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="{x:Type RepeatButton}"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderVideo" TargetType="{x:Type Slider}">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid VerticalAlignment="Center" Background="Transparent">
            <Border Height="4" CornerRadius="2" Background="#55FFFFFF"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="White"/></ControlTemplate></RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource BotonPistaSlider}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="12" Height="12" Fill="White"/></ControlTemplate></Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tarjeta -->
  <Style x:Key="Tarjeta" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource Superficie}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Linea}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="18"/>
  </Style>
</ResourceDictionary>
